# ============================================================
# このファイルはコードが実際に読む環境変数名のみを記載している
# （application.conf / Application.kt を参照）
# ============================================================

# ---- サーバー設定 ----
PORT=8080

# CORS許可オリジン（複数指定はカンマ区切り）
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- データベース接続情報（オーナー: RLSをバイパスする接続） ----
PGHOST=localhost
PGPORT=5432
PGDATABASE=housework
PGUSER=housework
PGPASSWORD=housework_password

# JDBC_DATABASE_URLを設定すると、上記PGHOST/PGPORT/PGDATABASEから組み立てたURLより優先される（任意）
# 例: jdbc:postgresql://HOST:PORT/DATABASE_NAME
# JDBC_DATABASE_URL=

# ---- データベース接続情報（RLS適用側: housework_app） ----
# 本番環境では必ず設定すること。未設定（ローカル既定値のまま）でローカル以外のホストに
# 接続しようとするとアプリが起動時にエラーで停止する（DatabaseConfigの安全策）
APP_PGUSER=housework_app
APP_PGPASSWORD=housework_app_password

# ---- 認証 ----
# 本番環境では必ず強力なランダム文字列を設定すること
# 生成例: openssl rand -base64 32
JWT_SECRET=change-me

# ---- メール送信設定 ----
# "smtp" または "sendgrid" を指定。それ以外（未設定含む）はログ出力のみ
MAIL_PROVIDER=logging

# MAIL_PROVIDER=smtp の場合に使用
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
SMTP_USE_SSL=false
SMTP_SSL_TRUST=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_TIMEOUT_MS=10000
SMTP_USER=change-me
SMTP_PASSWORD=change-me
SMTP_FROM_ADDRESS=change-me@example.com
SMTP_FROM_NAME=Housework App

# MAIL_PROVIDER=sendgrid の場合に使用
SENDGRID_API_KEY=change-me
SENDGRID_FROM_ADDRESS=change-me@example.com
SENDGRID_FROM_NAME=Housework App

# ---- Web Push通知設定 ----
# VAPID鍵の生成: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:example@example.com

# ---- 通知スケジュール ----
# 毎日の未完了タスク通知を送る時刻（HH:mm形式）
NOTIFICATION_SCHEDULE_TIME=19:00
